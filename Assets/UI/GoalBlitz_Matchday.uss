.lobby-screen {
    flex-grow: 1;
    overflow: hidden;
    background-color: #071817;
    color: #f1e5c5;
}

.lobby-stadium-glow {
    position: absolute;
    top: -32%;
    left: 16%;
    width: 68%;
    height: 92%;
    border-radius: 420px;
    background-color: #285548;
    opacity: 0.36;
}

.lobby-orb {
    position: absolute;
    width: 250px;
    height: 250px;
    border-radius: 125px;
    opacity: 0.12;
    background-color: #d3b579;
}

.orb-left {
    left: -110px;
    top: 35%;
}

.orb-right {
    right: -110px;
    top: 35%;
    background-color: #2a87a2;
}

.lobby-overlay {
    flex-grow: 1;
    flex-direction: column;
    padding-left: 3.2%;
    padding-right: 3.2%;
    padding-top: 2.2%;
    padding-bottom: 2.2%;
}

.lobby-header {
    min-height: 92px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: #625b43;
    padding-bottom: 13px;
}

.back-button {
    width: 112px;
    height: 43px;
    margin-right: 20px;
    color: #e9d5a9;
    background-color: #122421;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #b5975d;
    border-right-color: #b5975d;
    border-top-color: #b5975d;
    border-bottom-color: #b5975d;
    border-radius: 5px;
    font-size: 14px;
    -unity-font-style: bold;
}

.back-button:hover {
    background-color: #24554a;
}

.room-heading {
    flex-grow: 1;
    min-width: 0;
}

.room-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: #f6e9c6;
}

.room-subtitle {
    font-size: 12px;
    color: #c8b78f;
    margin-top: 5px;
}

.room-code-group {
    flex-direction: row;
    align-items: center;
}

.code-caption {
    font-size: 11px;
    -unity-font-style: bold;
    color: #baa77f;
    margin-right: 9px;
}

.code-display {
    min-width: 124px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 7px;
    padding-bottom: 7px;
    -unity-text-align: middle-center;
    font-size: 21px;
    -unity-font-style: bold;
    color: #fff4dd;
    background-color: #182825;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #b5975d;
    border-right-color: #b5975d;
    border-top-color: #b5975d;
    border-bottom-color: #b5975d;
    border-radius: 5px;
}

.copy-button {
    height: 38px;
    margin-left: 8px;
    background-color: #27453d;
    color: #f2e1b8;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #b5975d;
    border-right-color: #b5975d;
    border-top-color: #b5975d;
    border-bottom-color: #b5975d;
    border-radius: 5px;
    -unity-font-style: bold;
}

.copy-button:hover {
    background-color: #3b6c5c;
}

.lobby-body {
    flex-grow: 1;
    justify-content: center;
}

.match-banner {
    align-items: center;
    margin-bottom: 20px;
}

.football-emoji {
    font-size: 32px;
    -unity-text-align: middle-center;
    margin-bottom: 5px;
}

.match-banner-title {
    font-size: 18px;
    color: #f1d99a;
    -unity-font-style: bold;
}

.match-banner-subtitle {
    margin-top: 5px;
    font-size: 13px;
    color: #aeb5a5;
}

.teams-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.team-column {
    width: 45%;
    min-width: 300px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-radius: 6px;
    overflow: hidden;
    background-color: #102421;
}

.blue-card {
    border-left-color: #318aa1;
    border-right-color: #318aa1;
    border-top-color: #318aa1;
    border-bottom-color: #318aa1;
}

.red-card {
    border-left-color: #a35d4d;
    border-right-color: #a35d4d;
    border-top-color: #a35d4d;
    border-bottom-color: #a35d4d;
}

.team-heading {
    height: 54px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    border-bottom-width: 2px;
}

.blue-heading {
    background-color: #123b48;
    border-bottom-color: #56b2c4;
}

.red-heading {
    background-color: #4a2b27;
    border-bottom-color: #cb735e;
}

.team-heading-text {
    font-size: 18px;
    -unity-font-style: bold;
    color: #fff0c9;
}

.team-count {
    font-size: 12px;
    color: #dac292;
}

.player-slot {
    min-height: 104px;
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    background-color: #102522;
}

.team-badge {
    width: 76px;
    height: 76px;
    min-width: 76px;
    margin-right: 15px;
    -unity-background-scale-mode: scale-to-fit;
}

.blue-badge {
    background-image: url("GoalBlitz_BlueLion_Badge.png");
}

.red-badge {
    background-image: url("GoalBlitz_RedBull_Badge.png");
}

.player-name {
    flex-grow: 1;
    font-size: 18px;
    color: #ede2c5;
}

.team-button {
    width: 98px;
    height: 42px;
    font-size: 14px;
    -unity-font-style: bold;
    color: #f7e7bd;
    background-color: #234439;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #b5975d;
    border-right-color: #b5975d;
    border-top-color: #b5975d;
    border-bottom-color: #b5975d;
    border-radius: 5px;
}

.blue-button:hover {
    background-color: #276e82;
}

.red-button:hover {
    background-color: #784239;
}

.versus-label {
    width: 56px;
    -unity-text-align: middle-center;
    font-size: 19px;
    -unity-font-style: bold;
    color: #d5bc7b;
}

.lobby-status {
    margin-top: 22px;
    -unity-text-align: middle-center;
    font-size: 15px;
    color: #d6bd83;
}

.lobby-footer {
    min-height: 66px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-top-width: 1px;
    border-top-color: #625b43;
}

.lobby-hint {
    font-size: 11px;
    color: #b5b8a9;
}

.footer-actions {
    flex-direction: row;
}

.lobby-action {
    min-width: 134px;
    height: 45px;
    margin-left: 10px;
    border-radius: 5px;
    -unity-font-style: bold;
    font-size: 14px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #b5975d;
    border-right-color: #b5975d;
    border-top-color: #b5975d;
    border-bottom-color: #b5975d;
}

.ready-button {
    background-color: #234439;
    color: #f2e2ba;
}

.ready-button:hover {
    background-color: #376b57;
}

.start-button {
    background-color: #d2b27b;
    color: #19231f;
}

.start-button:hover {
    background-color: #f0d59f;
}