.lobby-screen {
    flex-grow: 1;
    overflow: hidden;
    background-color: #071817;
    color: #f1e5c5;
}

.lobby-stadium-glow {
    position: absolute;
    top: -32%;
    left: 16%;
    width: 68%;
    height: 92%;
    border-radius: 420px;
    background-color: #285548;
    opacity: 0.36;
}

.lobby-orb {
    position: absolute;
    width: 250px;
    height: 250px;
    border-radius: 125px;
    opacity: 0.12;
    background-color: #d3b579;
}

.orb-left {
    left: -110px;
    top: 35%;
}

.orb-right {
    right: -110px;
    top: 35%;
    background-color: #2a87a2;
}

.lobby-overlay {
    flex-grow: 1;
    flex-direction: column;
    padding-left: 3.2%;
    padding-right: 3.2%;
    padding-top: 2.2%;
    padding-bottom: 2.2%;
}

/* Header */

.lobby-header {
    min-height: 118px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: #625b43;
    padding-bottom: 17px;
}

.back-button {
    width: 138px;
    height: 54px;
    margin-right: 24px;
    color: #e9d5a9;
    background-color: #122421;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #b5975d;
    border-right-color: #b5975d;
    border-top-color: #b5975d;
    border-bottom-color: #b5975d;
    border-radius: 5px;
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.back-button:hover {
    background-color: #24554a;
}

.room-heading {
    flex-grow: 1;
    min-width: 0;
}

.room-title {
    font-size: 42px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #f6e9c6;
}

.room-subtitle {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: #c8b78f;
    margin-top: 7px;
}

.room-code-group {
    flex-direction: row;
    align-items: center;
}

.code-caption {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: #baa77f;
    margin-right: 11px;
}

.code-display {
    min-width: 172px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 10px;
    -unity-text-align: middle-center;
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: #fff4dd;
    background-color: #182825;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #b5975d;
    border-right-color: #b5975d;
    border-top-color: #b5975d;
    border-bottom-color: #b5975d;
    border-radius: 5px;
}

.copy-button {
    height: 48px;
    min-width: 86px;
    margin-left: 10px;
    background-color: #27453d;
    color: #f2e1b8;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #b5975d;
    border-right-color: #b5975d;
    border-top-color: #b5975d;
    border-bottom-color: #b5975d;
    border-radius: 5px;
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.copy-button:hover {
    background-color: #3b6c5c;
}

/* Central lobby content */

.lobby-body {
    flex-grow: 1;
    justify-content: center;
}

.match-banner {
    align-items: center;
    margin-bottom: 28px;
    padding-top: 18px;
    padding-right: 28px;
    padding-bottom: 18px;
    padding-left: 28px;
}

.football-emoji {
    font-size: 42px;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.match-banner-title {
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #f1d99a;
}

.match-banner-subtitle {
    margin-top: 8px;
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    color: #aeb5a5;
}

/* Teams */

.teams-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.team-column {
    width: 45%;
    min-width: 390px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-radius: 6px;
    overflow: hidden;
    background-color: #102421;
}

.blue-card {
    border-left-color: #318aa1;
    border-right-color: #318aa1;
    border-top-color: #318aa1;
    border-bottom-color: #318aa1;
}

.red-card {
    border-left-color: #a35d4d;
    border-right-color: #a35d4d;
    border-top-color: #a35d4d;
    border-bottom-color: #a35d4d;
}

.team-heading {
    height: 70px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 20px;
    padding-right: 20px;
    border-bottom-width: 2px;
}

.blue-heading {
    background-color: #123b48;
    border-bottom-color: #56b2c4;
}

.red-heading {
    background-color: #4a2b27;
    border-bottom-color: #cb735e;
}

.team-heading-text {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: #fff0c9;
}

.team-count {
    font-size: 20px;
    -unity-font-style: bold;
    color: #dac292;
}

.player-slot {
    min-height: 116px;
    flex-direction: row;
    align-items: center;
    padding-top: 14px;
    padding-right: 18px;
    padding-bottom: 14px;
    padding-left: 18px;
    background-color: #102522;
}

.team-badge {
    width: 66px;
    height: 66px;
    margin-right: 18px;
    flex-shrink: 0;
}

.blue-badge {
    background-image: url("GoalBlitz_BlueLion_Badge.png");
}

.red-badge {
    background-image: url("GoalBlitz_RedBull_Badge.png");
}

.player-name {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 16px;
    min-width: 0;

    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: rgb(255, 248, 229);

    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.55);
    text-shadow: 0px 2px 0px rgba(0, 0, 0, 0.65);
}

.team-button {
    min-width: 124px;
    height: 58px;
    margin-left: auto;
    flex-shrink: 0;

    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: #f7e7bd;
    background-color: #234439;

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #b5975d;
    border-right-color: #b5975d;
    border-top-color: #b5975d;
    border-bottom-color: #b5975d;
    border-radius: 5px;
}

.blue-button:hover {
    background-color: #276e82;
}

.red-button:hover {
    background-color: #784239;
}

.versus-label {
    width: 76px;
    -unity-text-align: middle-center;
    font-size: 34px;
    -unity-font-style: bold;
    color: #d5bc7b;
}

/* Selected team state */

.blue-card .player-slot.team-selected {
    background-color: rgba(18, 67, 142, 0.88);
    border-top-color: rgb(121, 184, 255);
    border-right-color: rgb(121, 184, 255);
    border-bottom-color: rgb(121, 184, 255);
    border-left-color: rgb(121, 184, 255);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
}

.red-card .player-slot.team-selected {
    background-color: rgba(145, 38, 40, 0.88);
    border-top-color: rgb(255, 156, 150);
    border-right-color: rgb(255, 156, 150);
    border-bottom-color: rgb(255, 156, 150);
    border-left-color: rgb(255, 156, 150);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
}

.selected-player-name {
    color: rgb(255, 211, 92);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(87, 46, 8, 0.85);
    text-shadow: 0px 2px 0px rgba(53, 28, 5, 0.7);
}

/* Status and footer */

.lobby-status {
    min-height: 56px;
    margin-top: 28px;
    padding-top: 10px;
    padding-right: 18px;
    padding-bottom: 10px;
    padding-left: 18px;

    -unity-text-align: middle-center;
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    color: #d6bd83;
}

.lobby-footer {
    min-height: 86px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-top-width: 1px;
    border-top-color: #625b43;
}

.lobby-hint {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: #b5b8a9;
}

.footer-actions {
    flex-direction: row;
}

.lobby-action {
    min-width: 190px;
    height: 64px;
    margin-left: 12px;
    border-radius: 5px;

    -unity-font-style: bold;
    font-size: 25px;
    letter-spacing: 1.5px;

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #b5975d;
    border-right-color: #b5975d;
    border-top-color: #b5975d;
    border-bottom-color: #b5975d;
}

.ready-button {
    background-color: #234439;
    color: #f2e2ba;
}

.ready-button:hover {
    background-color: #376b57;
}

.start-button {
    background-color: #d2b27b;
    color: #19231f;
}

.start-button:hover {
    background-color: #f0d59f;
}